
1. BASIC
SELECT product_name, price
FROM products
WHERE price > (
    SELECT AVG(price)
    FROM products
);

2. 
SELECT product_name,price
FROM Products
Where price=(
select max(price)
from products
)

3.
Group By AND Having
SELECT product_id, SUM(quantity) AS total_quantity
FROM sales
GROUP BY product_id;

4.
SELECT product_id, SUM(quantity) AS total_quantity
FROM sales
GROUP BY product_id
HAVING SUM(quantity) > 10;
